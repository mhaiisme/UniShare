<%- include('../partials/header') %>
<%
const feedUrl = (changes) => {
  const values = Object.assign({}, f, {page:1}, changes || {});
  const params = new URLSearchParams();
  Object.keys(values).forEach(key => { if (values[key] && !(key === 'sort' && values[key] === 'newest') && !(key === 'page' && Number(values[key]) === 1)) params.set(key, values[key]); });
  return '/forum' + (params.size ? '?' + params.toString() : '');
};
const hasFilters = Boolean(f.category || f.q || f.course || f.response);
%>
<div class="forum-page">
  <header class="forum-header">
    <div>
      <p class="forum-eyebrow">BẢNG TIN HỌC TẬP</p>
      <h1>Cùng hỏi, <span>cùng hiểu.</span></h1>
      <p>Một câu hỏi của bạn có thể mở ra góc nhìn mới cho cả cộng đồng.</p>
      <div class="forum-community-counts"><span><strong><%= counts.posts.toLocaleString('vi-VN') %></strong> bài thảo luận</span><span><strong><%= counts.comments.toLocaleString('vi-VN') %></strong> phản hồi</span></div>
    </div>
    <div class="forum-header-art"><img src="/img/illustrations/open-book.svg" width="640" height="400" alt=""><a class="btn btn-primary forum-create" href="/forum/new?category=question"><%- include('../partials/forum-icon',{name:'plus'}) %>Đặt câu hỏi</a></div>
  </header>

  <form method="get" action="/forum" class="forum-search uf-filter" role="search" aria-label="Tìm thảo luận">
    <input type="hidden" name="category" value="<%= f.category %>">
    <input type="hidden" name="response" value="<%= f.response %>">
    <input type="hidden" name="sort" value="<%= f.sort %>">
    <label class="forum-search-main" for="forum-q"><span>Tìm trong cộng đồng</span><span class="forum-input-wrap"><%- include('../partials/forum-icon',{name:'search'}) %><input id="forum-q" name="q" value="<%= f.q %>" placeholder="Bạn đang vướng ở đâu?"></span></label>
    <label for="forum-course"><span>Mã học phần</span><input id="forum-course" name="course" value="<%= f.course %>" placeholder="Ví dụ: INT2210"></label>
    <button class="btn btn-primary" type="submit">Tìm bài viết</button>
  </form>

  <nav class="forum-categories" aria-label="Chuyên mục thảo luận">
    <a href="<%= feedUrl({category:''}) %>" class="forum-category <%= !f.category ? 'is-active' : '' %>" <%- !f.category ? 'aria-current="page"' : '' %>><%- include('../partials/forum-icon',{name:'all'}) %><span>Tất cả</span></a>
    <% Object.keys(config.POST_CATEGORIES).forEach(function(key){ %>
      <a href="<%= feedUrl({category:key}) %>" class="forum-category forum-category--<%= key %> <%= f.category === key ? 'is-active' : '' %>" <%- f.category === key ? 'aria-current="page"' : '' %>><%- include('../partials/forum-icon',{name:key}) %><span><%= config.POST_CATEGORIES[key] %></span></a>
    <% }) %>
  </nav>

  <% if(!hasFilters && page===1 && discussed.length){ const spotlight=discussed[0]; %>
  <section class="forum-spotlight" aria-labelledby="spotlight-title"><div class="spotlight-mark" aria-hidden="true"><%- include('../partials/forum-icon',{name:'message'}) %></div><div><p class="eyebrow">CUỘC TRAO ĐỔI NHIỀU PHẢN HỒI NHẤT</p><h2 id="spotlight-title"><a href="/forum/<%= spotlight.id %>"><%= spotlight.title %></a></h2><p><%= spotlight.author_name %> · <%= spotlight.comment_count %> phản hồi<%= spotlight.course_code?' · '+spotlight.course_code:'' %></p><a class="text-link" href="/forum/<%= spotlight.id %>#comments">Góp thêm góc nhìn →</a></div></section>
  <% } %>
  <div class="forum-layout">
    <section class="forum-feed" aria-labelledby="forum-feed-heading">
      <div class="forum-feed-heading"><h2 id="forum-feed-heading"><%= hasFilters ? 'Thảo luận phù hợp' : 'Góc trao đổi' %></h2><span><%= total.toLocaleString('vi-VN') %> bài viết</span></div>
      <div class="forum-toolbar">
        <nav class="forum-sort" aria-label="Sắp xếp bài viết"><a href="<%= feedUrl({sort:'newest'}) %>" class="<%= f.sort === 'newest' ? 'is-active' : '' %>" <%- f.sort === 'newest' ? 'aria-current="page"' : '' %>>Mới nhất</a><a href="<%= feedUrl({sort:'discussed'}) %>" class="<%= f.sort === 'discussed' ? 'is-active' : '' %>" <%- f.sort === 'discussed' ? 'aria-current="page"' : '' %>>Nhiều trao đổi</a></nav>
        <a class="forum-response-filter <%= f.response === 'unanswered' ? 'is-active' : '' %>" href="<%= feedUrl({response:f.response === 'unanswered' ? '' : 'unanswered'}) %>" <%- f.response === 'unanswered' ? 'aria-current="page"' : '' %>><%- include('../partials/forum-icon',{name:'clock'}) %>Chưa có phản hồi</a>
      </div>
      <%- include('../partials/filter-chips', {filterValues:f,filterRoute:'/forum'}) %>
      <div class="forum-post-list">
      <% posts.forEach(function(p){ %>
        <article class="forum-post forum-post--<%= p.category %>">
          <header class="forum-post-header">
            <a class="forum-avatar forum-avatar--<%= p.avatar_tone %>" href="/u/<%= p.user_id %>" aria-label="Hồ sơ <%= p.author_name %>"><%= p.author_initials %></a>
            <div class="forum-author-line"><a href="/u/<%= p.user_id %>"><%= p.author_name %></a><time><%= u.fmtDate(p.created_at, false) %></time></div>
            <a class="forum-topic-badge" href="<%= feedUrl({category:p.category}) %>"><%= config.POST_CATEGORIES[p.category] %></a>
          </header>
          <h3><a href="/forum/<%= p.id %>"><%= p.title %></a></h3>
          <details class="forum-preview"><summary><span class="forum-post-excerpt"><%= p.excerpt %></span><span class="forum-preview-hint">Mở trích đoạn ↓</span></summary><a href="/forum/<%= p.id %>">Đọc toàn bộ bài viết →</a></details>
          <footer class="forum-post-footer">
            <div class="forum-post-labels"><% if(p.school_code){ %><span class="forum-school"><%= p.school_code %></span><% } %><% if(p.course_code){ %><a href="<%= feedUrl({course:p.course_code}) %>" class="forum-course"><%= p.course_code %></a><% } %></div>
            <a class="forum-replies <%= p.comment_count ? 'has-replies' : '' %>" href="/forum/<%= p.id %>#comments"><%- include('../partials/forum-icon',{name:'message'}) %><span><%= p.comment_count ? p.comment_count + ' phản hồi' : 'Chưa có phản hồi' %></span><%- include('../partials/forum-icon',{name:'arrow'}) %></a>
          </footer>
        </article>
      <% }) %>
      </div>
      <% if(!posts.length){ %><div class="forum-empty"><div class="forum-empty-symbol"><%- include('../partials/forum-icon',{name:'message'}) %></div><h3><%= hasFilters ? 'Chưa tìm thấy cuộc trao đổi phù hợp' : 'Cùng mở đầu câu chuyện' %></h3><p><%= hasFilters ? 'Thử đổi từ khóa hoặc bỏ bớt bộ lọc.' : 'Đặt câu hỏi đầu tiên để cùng nhau tìm lời giải.' %></p><a href="<%= hasFilters ? '/forum' : '/forum/new?category=question' %>"><%= hasFilters ? 'Xem tất cả thảo luận' : 'Đặt câu hỏi' %> →</a></div><% } %>
      <% if(pages>1){ %>
      <nav class="forum-pagination" aria-label="Các trang thảo luận">
        <% if(page>1){ %><a href="<%= feedUrl({page:page-1}) %>">← Trước</a><% } %>
        <% if(page>3){ %><a href="<%= feedUrl({page:1}) %>">1</a><% if(page>4){ %><span>…</span><% }} %>
        <% for(let n=Math.max(1,page-2);n<=Math.min(pages,page+2);n++){ %><a href="<%= feedUrl({page:n}) %>" class="<%= page===n?'is-active':'' %>" <%- page===n?'aria-current="page"':'' %>><%= n %></a><% } %>
        <% if(page<pages-2){ if(page<pages-3){ %><span>…</span><% } %><a href="<%= feedUrl({page:pages}) %>"><%= pages %></a><% } %>
        <% if(page<pages){ %><a href="<%= feedUrl({page:page+1}) %>">Sau →</a><% } %>
      </nav><% } %>
    </section>
    <aside class="forum-sidebar" aria-label="Khám phá cộng đồng">
      <section class="forum-side-panel forum-help-panel">
        <div class="forum-side-heading"><span class="forum-side-kicker">GÓP MỘT LỜI GIẢI</span><h2>Câu hỏi đang chờ bạn</h2></div>
        <% if(unanswered.length){ %><div class="forum-side-list"><% unanswered.forEach(function(p){ %><a href="/forum/<%= p.id %>"><span class="forum-side-course"><%= p.course_code || config.POST_CATEGORIES[p.category] %></span><strong><%= p.title %></strong><span class="forum-side-action">Trở thành người phản hồi đầu tiên →</span></a><% }) %></div><% }else{ %><p class="forum-side-empty">Chưa có câu hỏi nào đang chờ phản hồi.</p><% } %>
        <a class="forum-side-more" href="/forum?category=question&response=unanswered">Xem câu hỏi chưa có phản hồi →</a>
      </section>
      <% if(topics.length){ %><section class="forum-side-panel forum-topic-panel"><h2>Tìm bạn cùng môn</h2><p class="forum-side-caption">Các học phần có nhiều bài thảo luận.</p><div class="forum-course-cloud"><% topics.forEach(function(t){ %><a href="<%= '/forum?' + new URLSearchParams({course:t.course_code}).toString() %>"><span><%= t.course_code %></span><small><%= t.post_count %> bài</small></a><% }) %></div></section><% } %>
      <% if(discussed.length){ %><section class="forum-side-panel"><h2>Nhiều góc nhìn</h2><div class="forum-side-list"><% discussed.forEach(function(p,i){ %><a class="forum-ranked-post" href="/forum/<%= p.id %>"><span class="forum-rank"><%= String(i+1).padStart(2,'0') %></span><span><strong><%= p.title %></strong><small><%= p.comment_count %> phản hồi</small></span></a><% }) %></div></section><% } %>
      <p class="forum-community-note">Hỏi rõ điều bạn chưa hiểu.<br>Chia sẻ điều bạn đã biết.</p>
    </aside>
  </div>
</div>
<%- include('../partials/footer') %>
