<%- include('../partials/header') %>
<div class="page-narrow">
  <div class="card">
    <div class="doc-meta">
      <span class="tag"><%= config.POST_CATEGORIES[post.category] %></span>
      <% if (post.school_name) { %><span class="tag"><%= post.school_name %></span><% } %>
      <% if (post.course_code) { %><span class="tag"><%= post.course_code %></span><% } %>
      <span class="muted small"><a href="/u/<%= post.user_id %>"><%= post.author_name %></a> · <%= u.fmtDate(post.created_at) %></span>
    </div>
    <h1><%= post.title %></h1>
    <div class="doc-body"><%- u.renderMarkdown(post.body) %></div>
    <% if (currentUser && (currentUser.id === post.user_id || currentUser.role === 'admin')) { %>
      <form method="post" action="/forum/<%= post.id %>/delete" onsubmit="return confirm('Xoá bài viết?')">
        <button class="btn btn-ghost btn-sm text-danger">Xoá bài</button>
      </form>
    <% } %>
  </div>

  <div class="card" id="comments">
    <h2>💬 Bình luận (<%= comments.length %>)</h2>
    <% comments.forEach(function (c) { %>
      <div class="review-item">
        <div><strong><%= c.author_name %></strong> <span class="muted small">· <%= u.fmtDate(c.created_at) %></span></div>
        <div><%= c.body %></div>
      </div>
    <% }) %>
    <% if (currentUser) { %>
      <form method="post" action="/forum/<%= post.id %>/comments" class="form">
        <textarea name="body" rows="3" required placeholder="Viết bình luận..."></textarea>
        <button class="btn btn-primary btn-sm">Gửi bình luận</button>
      </form>
    <% } else { %>
      <p><a href="/login">Đăng nhập</a> để bình luận.</p>
    <% } %>
  </div>
</div>
<%- include('../partials/footer') %>
