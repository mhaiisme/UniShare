};
const palettes = {
 royal:['#153e7b','#09254f','#ffffff','#8ec6f2','#d7e7f8'],
 cobalt:['#135ca2','#0a3265','#ffffff','#a4d9f3','#deebf8'],
 midnight:['#192c4a','#0b182e','#ffffff','#d5ba78','#e4e8ef'],
 forest:['#164e4a','#092e2d','#ffffff','#b4d9bb','#e1ede8'],
 petrol:['#1d566a','#0d3548','#ffffff','#a9d7d7','#deedf1'],
 slate:['#354c62','#1e2e40','#ffffff','#c8d9e8','#e6ecf2'],
 plum:['#613849','#351d30','#ffffff','#e0be9b','#eee5e9'],
 vermilion:['#8b3b33','#54231f','#fffaf0','#f1d3a5','#f3e8e3'],
 ivoryblue:['#f3f6fa','#163767','#17365b','#3373ac','#e4edf6']
};
const nfc = value => String(value == null ? '' : value).normalize('NFC');
const title = nfc(book.title || 'Học liệu');
const ascii = title.normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/đ/g,'d').toLowerCase();
const course = nfc(book.course_code).trim().toUpperCase();
let design = courseDesigns[course];
let known = Boolean(design);
const wrap = (value,limit=17) => {
 const result=[]; let line='';
 for (const word of value.split(/\s+/)) {
  if (line && (line+' '+word).length>limit) { result.push(line);line=''; }
  if(word.length>limit) { if(line){result.push(line);line='';} for(let i=0;i<word.length;i+=limit)result.push(word.slice(i,i+limit)); }
  else line+=(line?' ':'')+word;
 }
 if(line)result.push(line);
 return result;
};
if(!design){
 const inferred = /co so du lieu/.test(ascii)?'database':/mang may tinh/.test(ascii)?'network':/tri tue nhan tao/.test(ascii)?'ai':/lap trinh/.test(ascii)?'programming':/phap luat|luat/.test(ascii)?'law':/xac suat|thong ke/.test(ascii)?'statistics':/dai so/.test(ascii)?'algebra':/giai tich|tich phan/.test(ascii)?'calculus':/kinh te/.test(ascii)?'econometrics':'reference';
 const shortTitle=title.replace(/^(Giáo trình|Sách bài tập|Tài liệu tham khảo|Tuyển tập bài tập|Hướng dẫn học tập)\s+/i,'').replace(/\s*\([^)]*\)\s*$/,'');
 design=[wrap(shortTitle.toLocaleUpperCase('vi-VN')),inferred,'royal'];
}
let [heading,motif,paletteName]=design;
let subtitle='';
if(/introduction to algorithms/.test(ascii)){heading=['INTRODUCTION','TO ALGORITHMS'];paletteName='midnight';subtitle='CORMEN · LEISERSON · RIVEST · STEIN';}
else if(/stata|eviews/.test(ascii)) subtitle='BÀI TẬP & THỰC HÀNH STATA / EVIEWS';
else if(/va ung dung/.test(ascii)) subtitle='VÀ ỨNG DỤNG';
else if(/tuyen tap bai tap & huong dan/.test(ascii)) subtitle='TUYỂN TẬP BÀI TẬP & HƯỚNG DẪN';
const kind=/^sach bai tap/.test(ascii)?'BÀI TẬP':/^tuyen tap/.test(ascii)?'TUYỂN TẬP':/^huong dan/.test(ascii)?'HƯỚNG DẪN HỌC TẬP':/^tai lieu/.test(ascii)?'TÀI LIỆU THAM KHẢO':/ban in tham khao/.test(ascii)?'BẢN IN THAM KHẢO':'GIÁO TRÌNH';
const variant=/^sach bai tap|^tuyen tap/.test(ascii)?'practice':/^huong dan/.test(ascii)?'guide':/^tai lieu|ban in tham khao/.test(ascii)?'reference':'textbook';
const p=palettes[paletteName];
const uid='cover-'+String(book.id || 'new').replace(/[^a-zA-Z0-9_-]/g,'')+'-'+Math.random().toString(36).slice(2,9);
const lines=heading.slice(0,4);
if(heading.length>4)lines[3]=lines[3].slice(0,15)+'…';
const textSize=Math.max(17,Math.min(29, Math.floor(320/Math.max(...lines.map(t=>t.length)))));
const courseNumber=Array.from(course).reduce((a,c)=>a+c.charCodeAt(0),0);
%>
