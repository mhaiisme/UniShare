 <g transform="translate(0 185)" style="color:<%= p[3] %>">
  <% if(variant==='practice'){ %><path d="M0 0H218M0 32H218M0 64H218M0 96H218M0 128H218M0 160H218M0 0v160M32 0v160M64 0v160M96 0v160M128 0v160M160 0v160M192 0v160" fill="none" stroke="currentColor" stroke-opacity=".11"/><% } %>
  <% if(variant==='guide'){ %><path d="M0 0h36M0 0v36M218 124v36h-36" stroke="currentColor" opacity=".65" fill="none" stroke-width="2"/><% } %>
