<%
const names={q:'Từ khóa',school:'Trường',course:'Học phần',lecturer:'Giảng viên',type:'Loại tài liệu',price:'Truy cập',verified:'Đã xác thực A/A+',condition:'Tình trạng',bundle:'Có học liệu số',free:'Sách miễn phí',sort:'Sắp xếp',category:'Chuyên mục',response:'Phản hồi',status:'Trạng thái'};
const keys=Object.keys(filterValues).filter(k=>names[k] && filterValues[k] && !(k==='sort' && filterValues[k]==='newest'));
const link=(omit)=>{const p=new URLSearchParams();keys.forEach(k=>{if(k!==omit)p.set(k,String(filterValues[k]));});return filterRoute+(p.size?'?'+p.toString():'');};
const label=(k)=>{const v=filterValues[k];if(['verified','bundle','free'].includes(k))return names[k];let text=v;const maps={type:config.DOC_TYPES,condition:config.CONDITIONS,category:config.POST_CATEGORIES,status:config.DOC_STATUS,price:{free:'Miễn phí',paid:'Trả phí'},response:{unanswered:'Chưa có phản hồi',answered:'Có phản hồi'},sort:{rating:'Đánh giá cao',popular:'Nhiều lượt xem',price_asc:'Giá tăng dần',price_desc:'Giá giảm dần',discussed:'Nhiều trao đổi'}};if(maps[k])text=maps[k][v]||v;if(k==='school'&&typeof schools!=='undefined'){const s=schools.find(s=>String(s.id)===String(v));if(s)text=s.code;}return names[k]+': '+text;};
%>
<% if(keys.length){ %><nav class="uf-chips" aria-label="Điều kiện đang áp dụng"><span class="uf-chips-title">Đang lọc</span><% keys.forEach(k=>{ %><a class="uf-chip" href="<%= link(k) %>" aria-label="<%= 'Bỏ điều kiện '+label(k) %>"><span><%= label(k) %></span><span aria-hidden="true">×</span></a><% }); %><a class="uf-clear" href="<%= filterRoute %>">Xóa tất cả</a></nav><% } %>
